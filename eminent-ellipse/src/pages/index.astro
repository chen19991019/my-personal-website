---
import Background from '../components/Background.astro';
import Education from '../components/Education.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import Projects from '../components/Projects.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#edf2f1" />
		<meta
			name="description"
			content="A personal introduction to Hong Chen, their background, education, and projects."
		/>
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Hong Chen | Personal Bio</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="page-shell">
			<header class="site-header">
				<a class="wordmark" href="#top" aria-label="Hong Chen, back to top">HC</a>
				<nav aria-label="Main navigation">
					<a href="#background">Background</a>
					<a href="#education">Education</a>
					<a href="#projects">Projects</a>
				</nav>
			</header>

			<main id="main-content">
				<Intro />
				<Background />
				<Education />
				<Projects />
			</main>

			<Footer />
		</div>
	</body>
</html>
