---
import Activities from '../components/Activities.astro';
import Background from '../components/Background.astro';
import Education from '../components/Education.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import Publications from '../components/Publications.astro';
import Projects from '../components/Projects.astro';
import WorkExperience from '../components/WorkExperience.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#edf2f1" />
		<meta
			name="description"
			content="A personal introduction to Hong Chen, including education, work experience, research, publications, training, and conferences."
		/>
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<title>Hong Chen | Personal Bio</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="page-shell">
			<header class="site-header">
				<a class="wordmark" href="#top" aria-label="Hong Chen, back to top">HC</a>
				<nav aria-label="Main navigation">
					<a href="#education">Education</a>
					<a href="#work-experience">Work Experience</a>
					<a href="#research-projects">Research Projects</a>
					<a href="#publications">Publications</a>
					<a href="#training-and-conference">Training and Conference</a>
				</nav>
			</header>

			<main id="main-content">
				<Intro />
				<Background />
				<Education />
				<WorkExperience />
				<Projects />
				<Publications />
				<Activities />
			</main>

			<Footer />
		</div>
	</body>
</html>
